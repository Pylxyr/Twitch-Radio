{
  "name": "twitch-radio",
  "productName": "Twitch Radio",
  "version": "1.3.2",
  "description": "Twitch Radio: desktop control panel for the song-request radio",
  "main": "main.js",
  "private": true,
  "author": "Twitch Radio",
  "license": "Unlicense",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "check": "node scripts/check-syntax.js",
    "check:build": "node scripts/check-build-config.js",
    "check:fuses": "node scripts/check-fuses.js",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "test": "node --test \"test/*.test.js\"",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64",
    "dist:linux-dir": "electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "42.11.10",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "globals": "17.13.0"
  },
  "build": {
    "appId": "com.twitchradio.app",
    "productName": "Twitch Radio",
    "copyright": "Twitch Radio",
    "directories": {
      "output": "../dist/app",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updates.js",
      "validate.js",
      "theme.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/core/TwitchRadioCore",
        "to": "core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../packaging/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": true,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Twitch Radio",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "license": "../THIRD_PARTY_NOTICES.txt",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Twitch song-request radio",
      "executableName": "twitch-radio",
      "artifactName": "Twitch-Radio-${version}-linux-x64.${ext}",
      "syncDesktopName": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "twitch-radio.desktop"
}
