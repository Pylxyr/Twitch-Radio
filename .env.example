# ─────────────────────────────────────────────────────────────
# Twitch Radio. The four Twitch values below are required; everything else
# is optional and shown with its default.
#
# The desktop app edits this file for you (Settings tab). Edit it by hand only
# if you run the bot from source. Authorizing the two Twitch accounts is a
# separate one-time step: see the walkthrough in README.md.
# ─────────────────────────────────────────────────────────────

# From https://dev.twitch.tv/console/apps. Register an application there
# (OAuth Redirect URL: http://localhost:4343/oauth/callback); the Client ID
# and a generated Client Secret both come from that app's page.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Numeric Twitch user IDs, not usernames: digits only, nothing else (not
# "Twitch ID:1536026185", just "1536026185"). BOT_ID is the account the bot
# chats as (a dedicated account, made a moderator in your channel is
# recommended); OWNER_ID is the broadcaster/channel the bot joins. Look either
# up from a username at
# https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BOT_ID=
TWITCH_OWNER_ID=

# ─────────────────────────────────────────────────────────────
# Audio
# ─────────────────────────────────────────────────────────────

# Opus bitrate of the stream served to OBS. 160 (the default) is already
# transparent for nearly everything; there is little reason to go above 192.
# AUDIO_BITRATE_KBPS=160

# ─────────────────────────────────────────────────────────────
# Local server (this computer only)
# ─────────────────────────────────────────────────────────────

# The bot serves the queue as a live Opus stream plus a visual overlay, which
# you add as sources in OBS:
#   - Media Source   -> http://127.0.0.1:8098/stream.opus
#   - Browser Source -> http://127.0.0.1:8098/overlay
# and a settings page at http://127.0.0.1:8098/settings.
#
# It listens on 127.0.0.1 only, so nothing here is reachable from your
# network. Only the port can be changed.
# TWITCH_NOWPLAYING_PORT=8098

# Filenames under data/. No reason to change these unless you run more than
# one instance out of one folder.
# TWITCH_TOKEN_FILE=twitch_tokens.json
# TWITCH_TUNABLES_FILE=tunables.json
# TWITCH_TOGGLES_FILE=toggles.json

# While nobody is connected to /stream.opus the bot does no audio encoding at
# all, but the queue still advances on its own real-time clock: whatever
# plays while OBS is away is simply gone. Set this to true to hold off
# starting a new track until someone is listening again (a track already
# playing always finishes).
# PAUSE_QUEUE_WHEN_NO_LISTENERS=false

# ─────────────────────────────────────────────────────────────
# yt-dlp
# ─────────────────────────────────────────────────────────────

# Path to a cookies.txt file (Netscape format), relative to this folder.
# Leave unset on a home connection: ordinary public searches and links don't
# need it, and yt-dlp's "The page needs to be reloaded" failure shows up MORE
# often with cookies enabled (https://github.com/yt-dlp/yt-dlp/issues/16212).
# Only needed for age-restricted or members-only videos, or if YouTube asks
# you to "sign in to confirm you're not a bot". Must be a path under data/
# (yt-dlp rewrites this file on every request, so it needs a writable
# location); checked at startup.
# YTDLP_COOKIES_FILE=data/cookies.txt

# URL of a local bgutil-ytdlp-pot-provider instance, a cookie-free
# alternative for the "not a bot" problem. Leave unset otherwise.
# YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416

# yt-dlp needs an external JavaScript runtime for some YouTube requests (Deno,
# Node, Bun or QuickJS, see https://github.com/yt-dlp/yt-dlp/wiki/EJS). Leave
# these unset and a `deno` on PATH is found automatically (the desktop app
# brings its own). Pin a binary only if you need to; Node must be 22 or newer.
# YTDLP_JS_RUNTIME_PATH=
# YTDLP_JS_RUNTIME_NAME=deno

# Comma-separated override for yt-dlp's YouTube player_client selection.
# Leave unset for the built-in default. If YTDLP_COOKIES_FILE is set, at
# least one client here must support cookies (android/android_vr/ios/
# visionos/tv_simply reject cookie auth). Checked at startup.
# YTDLP_PLAYER_CLIENT=

# How long (seconds) a resolved song is reused instead of being looked up
# again. Every !sr resolves once in chat and again when it is prepared for
# playing; this avoids paying twice for anything near the front of the queue.
# 0 disables caching only: queued songs are still prepared ahead of time.
# Range 0-3600.
# YTDLP_CACHE_TTL_SECONDS=900

# Lookups run in separate yt-dlp processes that are started when needed and
# exit after being idle, so they cost memory (roughly 50-100 MB each) only
# while !sr requests are actually in flight.
#   YTDLP_CONCURRENCY             most lookups at once (1-8)
#   YTDLP_WORKER_IDLE_SECONDS     how long an unused process stays loaded (15-3600)
#   YTDLP_EXTRACT_TIMEOUT_SECONDS give up on one lookup after this long
# YTDLP_CONCURRENCY=2
# YTDLP_WORKER_IDLE_SECONDS=120
# YTDLP_EXTRACT_TIMEOUT_SECONDS=45

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_TO_FILE=true

# --- Overlay timing ------------------------------------------------------------------------------

# Seconds the overlay and the dashboard trail the player, so that the song they show changes when
# you hear it change. OBS and audio players buffer a stream before playing it; if the overlay still
# runs ahead of the sound raise this, if it lags behind lower it. 0 to 15.
# OVERLAY_DELAY_SECONDS=4
